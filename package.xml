<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>serial_can_bridge</name>
  <version>1.0.0</version>
  <description>ROS 2 bridge for RobStride USB-CAN AT serial packets with DLC 0 to 8.</description>
  <maintainer email="tengbenliang742@gmail.com">ryo-0723</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/ryo-0723/ros2_serial_can_bridge</url>
  <url type="bugtracker">https://github.com/ryo-0723/ros2_serial_can_bridge/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>boost</depend>
  <depend>can_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
